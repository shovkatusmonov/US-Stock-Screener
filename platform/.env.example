# US STOCK SCREENER CONFIGURATION
# Copy this file to .env and fill in your values.

# Database
# DB_PATH=data/screener.db

# Memory & Process Control (Safe for 1 GB RAM VPS)
MAX_RAM_MB=750
BATCH_SIZE_DOWNLOAD=25
BATCH_SIZE_SCREENING=50
MAX_CONCURRENT_WORKERS=2

# Data Provider Limits
MARKET_DATA_PROVIDER=yfinance
YFINANCE_RATE_LIMIT_DELAY=0.2
REQUEST_TIMEOUT=15
MAX_RETRIES=3

# Telegram Bot (Private & Admin-Only)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of numeric Telegram User IDs
ADMIN_USER_IDS=123456789,987654321

# Logging
LOG_LEVEL=INFO
